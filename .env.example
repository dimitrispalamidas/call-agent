# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...

# Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1...

# App URLs (use ngrok/cloudflare tunnel in local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
VOICE_SERVER_URL=http://localhost:3001
VOICE_SERVER_WS_URL=wss://YOUR_TUNNEL_HOST
VOICE_PORT=3001

# Shared secret so voice service can call internal web APIs if needed
INTERNAL_API_SECRET=change-me-to-a-long-random-string
